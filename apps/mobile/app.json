{
  "expo": {
    "name": "NuraCare",
    "slug": "nuracare",
    "version": "1.0.8",
    "orientation": "portrait",
    "scheme": "nuracare",
    "icon": "./assets/images/icon.png",
    "owner": "darikab71",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8ef278f-9fa4-426b-b682-73785a5bea8d"
      }
    },
    "android": {
      "jsEngine": "hermes",
      "package": "com.darikab71.nuracaremobile",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/icon.png",
          "imageWidth": 150
        }
      ]
    ]
  }
}
